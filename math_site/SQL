CREATE DATABASE mathapp;

USE mathapp;


CREATE TABLE Usuario (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nome VARCHAR(150) NOT NULL,
    email VARCHAR(150) UNIQUE NOT NULL,
    senha VARCHAR(255) NOT NULL,
    nascimento DATE NOT NULL
);

CREATE TABLE Estudante (
    id INT PRIMARY KEY,
    FOREIGN KEY (id) REFERENCES Usuario(id) ON DELETE CASCADE
);


CREATE TABLE Professor (
    id INT PRIMARY KEY,
    FOREIGN KEY (id) REFERENCES Usuario(id) ON DELETE CASCADE
);


CREATE TABLE Admin (
    id INT PRIMARY KEY,
    FOREIGN KEY (id) REFERENCES Usuario(id) ON DELETE CASCADE
);


CREATE TABLE Turma (
  id INT AUTO_INCREMENT PRIMARY KEY,
  nome VARCHAR(60),
  descricao VARCHAR(600),
  chave VARCHAR(6) UNIQUE,
  id_professor INT,
  FOREIGN KEY (id_professor) REFERENCES Professor(id) ON DELETE CASCADE
);



CREATE TABLE Competicao (
  id INT AUTO_INCREMENT PRIMARY KEY,
  descricao VARCHAR(600),
  nome VARCHAR(60),
  chave VARCHAR(8),
  id_professor INT,
  FOREIGN KEY (id_professor) REFERENCES Professor(id) ON DELETE CASCADE
);



CREATE TABLE Simulado (
 id INT AUTO_INCREMENT PRIMARY KEY,
 tempo_limite INT,
 numero_questoes INT,
 id_estudante INT,
 FOREIGN KEY (id_estudante) REFERENCES Estudante(id) ON DELETE CASCADE
 );

CREATE TABLE Questao (
    id INT AUTO_INCREMENT PRIMARY KEY,
    enunciado TEXT NOT NULL
);

CREATE TABLE Questao_Vestibular (
    id INT PRIMARY KEY,
    instituicao VARCHAR(100),
    dificuldade ENUM('facil', 'medio', 'dificil') NOT NULL,
    imagem VARCHAR(255) DEFAULT "não tem",
    FOREIGN KEY (id) REFERENCES Questao(id) ON DELETE CASCADE
);

CREATE TABLE Questao_Introdutoria (
    id INT PRIMARY KEY,
    FOREIGN KEY (id) REFERENCES Questao(id) ON DELETE CASCADE
);

CREATE TABLE Alternativa (
    id INT AUTO_INCREMENT PRIMARY KEY,
    questao_id INT,
    texto TEXT NOT NULL,
    letra CHAR(1) NOT NULL,
    correta BOOLEAN NOT NULL,

    FOREIGN KEY (questao_id) REFERENCES Questao(id) ON DELETE CASCADE
);

CREATE TABLE Conteudo (
  id INT AUTO_INCREMENT PRIMARY KEY,
  dificuldade ENUM('facil', 'medio', 'dificil') NOT NULL,
  descricao VARCHAR(400),
  nome VARCHAR(50)
);


CREATE TABLE Passo_a_Passo (
    id INT AUTO_INCREMENT PRIMARY KEY,
    questao_id INT NOT NULL,
    ordem_passo VARCHAR(10) NOT NULL,
    texto TEXT NOT NULL,
    resposta_correta VARCHAR(60) NOT NULL,
    FOREIGN KEY (questao_id) REFERENCES Questao_Introdutoria(id) ON DELETE CASCADE
);


CREATE TABLE Estudante_Competicao (
  id_estudante INT,
  id_competicao INT,
  
  PRIMARY KEY (id_estudante, id_competicao),
  
  FOREIGN KEY (id_estudante) REFERENCES Estudante(id) ON DELETE CASCADE,
  FOREIGN KEY (id_competicao) REFERENCES Competicao(id) ON DELETE CASCADE
);


CREATE TABLE Estudante_Turma (
  id_estudante INT,
  id_turma INT,
  
  PRIMARY KEY (id_estudante, id_turma),
  
  FOREIGN KEY (id_estudante) REFERENCES Estudante(id) ON DELETE CASCADE,
  FOREIGN KEY (id_turma) REFERENCES Turma(id) ON DELETE CASCADE
);


CREATE TABLE Estudante_Questao (
    id_estudante INT,
    id_questao INT,
    acerto BOOLEAN,
    resposta VARCHAR(60),
    data_realizacao DATE,
    PRIMARY KEY (id_estudante, id_questao),   

    FOREIGN KEY (id_estudante) REFERENCES Estudante(id) ON DELETE CASCADE,
    FOREIGN KEY (id_questao) REFERENCES Questao(id) ON DELETE CASCADE
);


CREATE TABLE Estudante_Passo (
    id_estudante INT,
    id_passo INT,
    acerto BOOLEAN,
    resposta VARCHAR(60),
    data_realizacao DATE,
    numero_tentativa INT DEFAULT 0,
    PRIMARY KEY (id_estudante, id_passo),   

    FOREIGN KEY (id_estudante) REFERENCES Estudante(id) ON DELETE CASCADE,
    FOREIGN KEY (id_passo) REFERENCES Passo_a_Passo(id) ON DELETE CASCADE
);


CREATE TABLE Questao_Passo (
    id_questao INT,
    id_passo INT,
  
    PRIMARY KEY (id_questao, id_passo),
  
    FOREIGN KEY (id_questao) REFERENCES Questao_Introdutoria(id) ON DELETE CASCADE,
    FOREIGN KEY (id_passo) REFERENCES Passo_a_Passo(id) ON DELETE CASCADE
);

CREATE TABLE Questao_Conteudo (
    id_questao INT,
    id_conteudo INT,
  
    PRIMARY KEY (id_questao, id_conteudo),
  
    FOREIGN KEY (id_questao) REFERENCES Questao(id) ON DELETE CASCADE,
    FOREIGN KEY (id_conteudo) REFERENCES Conteudo(id) ON DELETE CASCADE
);


CREATE TABLE Simulado_Questao (
    id_questaovest INT,
    id_simulado INT,
  
    PRIMARY KEY (id_questaovest, id_simulado),
  
    FOREIGN KEY (id_questaovest) REFERENCES Questao_Vestibular(id) ON DELETE CASCADE,
    FOREIGN KEY (id_simulado) REFERENCES Simulado(id) ON DELETE CASCADE
);

CREATE TABLE Competicao_Questao (
    id_questaovest INT,
    id_competicao INT,
  
    PRIMARY KEY (id_questaovest, id_competicao),
  
    FOREIGN KEY (id_questaovest) REFERENCES Questao_Vestibular(id) ON DELETE CASCADE,
    FOREIGN KEY (id_competicao) REFERENCES Competicao(id) ON DELETE CASCADE
);

CREATE TABLE Turma_Questao (
    id_questao INT,
    id_turma INT,
  
    PRIMARY KEY (id_questao, id_turma),
  
    FOREIGN KEY (id_questao) REFERENCES Questao(id) ON DELETE CASCADE,
    FOREIGN KEY (id_turma) REFERENCES Turma(id) ON DELETE CASCADE


);


